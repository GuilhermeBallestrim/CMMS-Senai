FROM python:3.12-slim

WORKDIR /app

# Copiar requirements (ou criar um específico)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código
COPY . .

# O frontend roda junto com o backend (Jinja2 server-side)
# Então não precisa de comando separado

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]