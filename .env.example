# Gere uma chave de sessão com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CMMS_SESSION_SECRET=troque-por-uma-chave-aleatoria

# development = SQLite local (cria o schema sozinho)
# production  = Postgres obrigatório (use `alembic upgrade head`)
CMMS_ENV=development
CMMS_DATABASE_URL=sqlite:///./cmms.db

# ---- Supabase (CMMS_ENV=production) ----
# Settings -> Database -> Connection string -> URI (session pooler, porta 5432).
# Cole o valor como está: o backend converte postgresql:// para postgresql+psycopg://.
# Se a senha tiver @ : / # ?, ela precisa estar codificada em URL (%40, %3A, ...).
# CMMS_DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
#
# Limite de conexões do pool (o pooler do Supabase é o gargalo).
# pool_size + max_overflow não devem ultrapassar o plano contratado.
CMMS_DB_POOL_SIZE=5
CMMS_DB_MAX_OVERFLOW=5

# Só em desenvolvimento.
CMMS_DEBUG=false
