# Gere uma chave de sessão com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CMMS_SESSION_SECRET=troque-por-uma-chave-aleatoria

# development = logs de debug habilitados; production = HTTPS obrigatório.
CMMS_ENV=development

# ---- Supabase (obrigatório em todos os ambientes) ----
# Crie o projeto em https://supabase.com e copie de
# Settings -> API -> Project URL e a service_role key (NUNCA a anon key).
CMMS_SUPABASE_URL=https://SEU_PROJETO.supabase.co
CMMS_SUPABASE_KEY=cole-aqui-a-service-role-key

# Apenas para desenvolvimento local.
CMMS_DEBUG=false